# =============================================================================
# AI 智能测试平台 —— 生产环境变量示例（docker compose 单机部署）
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为同目录下的 .env：cp .env.production.example .env
#   2. 按下方注释逐项填写，凡标注「必改」的危险默认值必须替换为强随机值
#   3. compose 内所有服务通过 env_file: .env 注入本文件
#
# 【极其重要 · 大小写敏感】
#   后端 Settings 配置 case_sensitive=True。
#   - 数据库 / 管理员相关键全部小写：db_host db_port db_user db_password
#     database admin_username admin_password admin_email
#   - 其余键全部大写：SECRET_KEY REDIS_URL CELERY_* ENV DEBUG ...
#   写错大小写 = 该项不生效、回落到代码内危险默认值。
#
# 【主机名】容器间互通一律用 compose 服务名，绝不用 localhost / 127.0.0.1：
#   MySQL → mysql      Redis → redis      后端 API → backend-api
#
# 【强随机值生成命令】
#   SECRET_KEY                 ：openssl rand -hex 32
#   各类密码（DB / Redis / admin）：openssl rand -base64 24
# =============================================================================


# =============================================================================
# 一、MySQL（容器自建 mysql:8.0，服务名 mysql，容器内端口固定 3306）
#     说明：root 账号与应用账号分离——应用只用 aitest_app 账号连库，
#           root 仅供 MySQL 容器自身初始化 / 运维，两者密码必须不同。
# =============================================================================

# --- 应用侧连库参数（后端读取，全部小写）---
db_host=mysql
# 容器内部端口固定 3306（对外仅映射到宿主 127.0.0.1:3307，不影响此处）
db_port=3306
# 独立应用账号（非 root）；必须与下方 MYSQL_USER 一致
db_user=aitest_app
# 【必改】应用账号密码：openssl rand -base64 24
#   必须与 MYSQL_PASSWORD 完全一致，且与 MYSQL_ROOT_PASSWORD 不同
db_password=CHANGE_ME_app_db_password
# 数据库名；必须与 MYSQL_DATABASE 一致
database=ai_test_platform

# --- MySQL 容器初始化参数（仅 mysql 服务读取）---
# 【必改】root 密码：openssl rand -base64 24（务必与 db_password 不同）
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
# 首启自动建库；与 database 保持一致
MYSQL_DATABASE=ai_test_platform
# 首启自动创建该应用账号并对 MYSQL_DATABASE 授全权；与 db_user 一致
MYSQL_USER=aitest_app
# 【必改】应用账号密码，必须与 db_password 完全相同
MYSQL_PASSWORD=CHANGE_ME_app_db_password

# --- 连接池（后端读取；每进程上限 = DB_POOL_SIZE + DB_MAX_OVERFLOW）---
# 默认 10+5=15/进程，连接预算 ≈195 < MySQL max-connections=300（见 docker-compose.yml 注释）。
# 横扩 worker 副本会线性增加连接数，超出时需同步上调 mysql --max-connections。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5


# =============================================================================
# 二、Redis（容器自建 redis:7-alpine，服务名 redis，容器内端口固定 6379）
#     用途：Celery broker(db1) / result backend(db2) + AI 事件总线 Pub/Sub(db0)
#           + 分布式运行锁。已开 requirepass + appendonly 持久化。
# =============================================================================

# 【必改】Redis 访问密码：openssl rand -base64 24
#   仅作为 redis 服务 requirepass 启动参数使用；
#   应用层真正鉴权靠下方三条 URL 内联的密码（须与本值一致）。
REDIS_PASSWORD=CHANGE_ME_redis_password

# AI 事件总线 Pub/Sub → db0；host=redis 服务名，密码内联。
# 下面三处 CHANGE_ME_redis_password 必须替换为与 REDIS_PASSWORD 相同的值。
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
# Celery broker → db1
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_password@redis:6379/1
# Celery result backend → db2
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_password@redis:6379/2


# =============================================================================
# 三、安全 / JWT
# =============================================================================

# 【必改 · 最危险默认值】JWT 签名密钥：openssl rand -hex 32
#   代码默认 your-secret-key-change-in-production 生产绝不可用。
#   轮换本值会使全部已签发 token 立即失效（所有用户需重新登录）。
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32


# =============================================================================
# 四、初始管理员（首启播种，仅 init 容器写入一次）
#     注意：create_admin_user 按 username 查重，首启建账号后再改本节
#           不会更新已存在账号——admin_password 必须在首次部署前设好。
# =============================================================================

admin_username=admin
# 【必改】管理员密码：openssl rand -base64 24
#   代码默认 admin123456 生产绝不可用；首启前务必设好（事后改无效）
admin_password=CHANGE_ME_admin_password
admin_email=admin@yourorg.com


# =============================================================================
# 五、运行环境 / 日志 / 时区
# =============================================================================

# 生产显式声明 production
ENV=production
# 生产必须关闭，避免泄露调试信息（代码默认 True）
DEBUG=false
# 生产关闭 SQL 回显
SQL_ECHO=false
LOG_LEVEL=INFO
# Celery 及应用时区
TIMEZONE=Asia/Shanghai


# =============================================================================
# 六、CORS / 上传
# =============================================================================

# 推荐 nginx 同源反代（前端走相对 /api），此项留空即可。
# 仅当确需跨域时填写具体来源（如 http://<公网IP>）；
# 因 allow_credentials=True，禁止使用通配符 *，必须写具体 origin。
BACKEND_CORS_ORIGINS=

# 单文件上传大小上限（MB）；必须与 nginx client_max_body_size 100m 对齐，
# 否则大附件会被 nginx 以 413 拦截。
MAX_UPLOAD_SIZE=100


# =============================================================================
# 七、Web 自动化浏览器
# =============================================================================

# 由 os.environ 读取（非 config 字段）。
# 服务器无显示环境，必须 false / 留空（无头）；
# 设 true 需 xvfb 虚拟显示，生产无此需要。仅影响 node agent 的 open 命令。
AGENT_BROWSER_HEADED=false


# =============================================================================
# 八、AI 模型（可留空）
# =============================================================================

# 遗留全局配置，留空即可。AI 能力走用户级 UserLlmConfig（存于数据库），
# 无需在此配置全局 key。学员首次使用 AI 前，需各自在前端配置
# 文本 / 嵌入 / 视觉 三类模型，否则 AI 接口返回 HTTP 400「请先配置大模型」。
AI_API_KEY=
