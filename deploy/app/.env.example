# =============================================================================
# 应用栈环境变量（后端 + LightRAG + Celery）—— 连接你【外部的】MySQL / Redis
# -----------------------------------------------------------------------------
# 用法：cp .env.example .env，按下方填写。键名【大小写敏感】(与 backend/app/core/config.py 一致)。
# 强随机值：SECRET_KEY 用 `openssl rand -hex 32`；各类密码已由你的外部 MySQL/Redis 决定。
# =============================================================================

# ========== 一、外部 MySQL（你自己部署的）==========
# db_host 填你 MySQL 的可达地址（内网 IP / 域名 / RDS 端点）。本机容器要能连通它，
# 且该 MySQL 已建好库与应用账号，并对该账号授予 database 的全部权限。
db_host=CHANGE_ME_mysql_host
db_port=3306
db_user=CHANGE_ME_mysql_user
db_password=CHANGE_ME_mysql_password
database=ai_test_platform
# 连接池：每 OS 进程上限 = DB_POOL_SIZE + DB_MAX_OVERFLOW。
# 本机进程数 ≈ api(2 gunicorn) + beat(1) + worker-ai(2 child) + worker-test(2 child) ≈ 7，
# 连接预算 ≈ 7×15 ≈ 105，确认你的 MySQL max_connections 留足余量。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ========== 二、外部 Redis（你自己部署的，需开 requirepass）==========
# 三条 URL 的 host 填你 Redis 的可达地址；<pw> 用你 Redis 的密码。
# 注意：密码内联进 URL，若含 @ : / 等特殊字符需 URL 编码（建议 Redis 密码用纯 hex 串免转义）。
# db0 = AI 事件总线 Pub/Sub；db1 = Celery broker；db2 = Celery result backend。
REDIS_URL=redis://:CHANGE_ME_redis_pw@CHANGE_ME_redis_host:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_redis_pw@CHANGE_ME_redis_host:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_redis_pw@CHANGE_ME_redis_host:6379/2

# ========== 三、安全 / JWT ==========
# 【必改】JWT 签名密钥：openssl rand -hex 32。轮换会使全部已签发 token 失效（需重新登录）。
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ========== 四、初始管理员（首启播种，仅 init 写一次）==========
# create_admin_user 按 username 查重，首启建账号后再改本节不会更新已存在账号——必须首次部署前设好。
admin_username=admin
admin_password=CHANGE_ME_admin_password
admin_email=admin@yourorg.com

# ========== 五、运行环境 ==========
ENV=production
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai

# ========== 六、CORS / 上传 ==========
# 前端经 nginx 同源反代 → 留空即可。需跨域填具体来源(逗号分隔或 JSON 数组，禁用 *)。
BACKEND_CORS_ORIGINS=
MAX_UPLOAD_SIZE=100

# ========== 七、backend-api 端口绑定 ==========
# 默认 127.0.0.1：前端/nginx 与本服务【同机】时用（最安全）。
# 前端在【另一台】：把 API_BIND 改为本机【内网 IP】，并用防火墙/安全组只放行前端机访问 8888。
API_BIND=127.0.0.1

# ========== 八、Web 自动化浏览器 ==========
# 服务器无显示环境，必须 false（无头）。
AGENT_BROWSER_HEADED=false

# ========== 九、AI 模型（留空）==========
# AI 能力走用户级 UserLlmConfig（存数据库），无需全局 key。学员首次用 AI 前需在前端配
# 文本/嵌入/视觉三类模型；知识库已自研（MySQL 单栈），embed 模型供向量检索使用。
AI_API_KEY=
